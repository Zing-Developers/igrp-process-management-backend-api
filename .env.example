SERVICE_PROFILE=development
SERVICE_PORT=8080
SERVICE_NAME=process-management-service

LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_SPRING_WEB=DEBUG
LOGGING_LEVEL_APP=DEBUG

POSTGRES_SERVICE_NAME=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=db_process_management
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

ENABLE_SWAGGER=true

SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=user@gmail.com
SPRING_MAIL_PASSWORD=password
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS_ENABLE=true
IGRP_MAIL_DEFAULT_FROM=no-reply@igrp.cv

AUTH_JWT_ISSUER=https://demoigrp.nosi.cv/auth/realms/igrp
IGRP_ACCESS_API_BASE_URL=https://user-manager-demoigrp.nosi.cv

EUREKA_CLIENT_ENABLED=false
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://igrp-eureka:8761/eureka/
EUREKA_CLIENT_REGISTERWITHEUREKA=true
EUREKA_CLIENT_FETCHREGISTRY=true
SPRING_CLOUD_DISCOVERY_ENABLED=true
SPRING_CLOUD_GATEWAY_DISCOVERY_LOCATOR_ENABLED=true
SPRING_CLOUD_GATEWAY_DISCOVERY_LOCATOR_LOWER_CASE_SERVICE_ID=true

SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Possible values are: kafka|rabbitmq|none
MESSAGE_BROKER_PROVIDER=kafka

# Possible values are: default|irn
# 'igrp' is NOT valid here: process-runtime-auth-igrp is not on this application's classpath, so the
# adapter bean would be missing and startup would fail.
IGRP_AUTHORIZATION_SERVICE_ADAPTER=irn

# Comma-separated browser origins allowed for CORS (with credentials). Empty = no cross-origin
# access at all — the previous wildcard+credentials setup let any site ride the user's session.
IGRP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Outbound SSRF policy for webhook/assignment delegates. Empty allowed-hosts = any PUBLIC host
# (internal ranges always blocked); set a comma list to restrict further or to allow an internal
# service explicitly. Extra headers lets a process variable set an otherwise-blocked header.
IGRP_OUTBOUND_REQUIRE_HTTPS=true
IGRP_OUTBOUND_ALLOWED_HOSTS=
IGRP_OUTBOUND_ALLOWED_EXTRA_HEADERS=
IGRP_OUTBOUND_MAX_RESPONSE_BYTES=1048576

# JWT claim used as the principal name — the identity recorded on tasks, audit columns and logs.
# MUST match the identity format task assignments use. IRN assigns by email, so 'email' is required
# for "my tasks" visibility matching; decide before go-live, never switch with existing data.
IGRP_SECURITY_PRINCIPAL_CLAIM_NAME=email

# IRN identity provider, required when the adapter above is 'irn'
IRN_API_BASE_URL=https://dsv-api-backoffice.irn.lan/exp-cvt-system-administration
IRN_API_SUPER_ADMIN_EMAIL=CHANGE_ME@irn.mj.pt
IRN_API_SESSION_COOKIE_NAME=session_id

# Signed RS256 client used to call the IRN API
IGRP_RESTCLIENT_PROVIDER=irn
IGRP_AUTHORIZATION_JWT_KEY=CHANGE_ME_JWT_KEY
IGRP_AUTHORIZATION_JWT_PRIVATE_KEY=file:/etc/igrp/keys/irn-private-key.pem

# Set to false to fall back to authenticated-only on routes with no rule (not recommended)
IRN_AUTHORIZATION_DENY_UNMATCHED=true

# Observability
# If you need observability, just enable the OpenTelemetry
OTEL_DISABLED=false
OTEL_COLLECTOR_ENDPOINT=http://localhost:4318
